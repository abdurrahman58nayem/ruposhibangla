# ---- Database (Neon Postgres) ----
# ছাড়া রাখলে সাইটটি লোকাল JSON স্টোরে চলবে (ডেমো/ডেভের জন্য)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/ruposhibangla?sslmode=require"

# ---- Cloudflare R2 (ছবি/ভিডিও স্টোরেজ) ----
# ঐচ্ছিক: অ্যাডমিন প্যানেল → "মিডিয়া / R2" থেকে বসানো যায় (ডেটাবেজে জমা হয়)।
# env-এ থাকলে সেটিই কার্যকর হবে; সেট না করলে আপলোড লোকাল public/uploads ফোল্ডারে জমা হবে
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ruposhibangla"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ---- Auth ----
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Admin ----
# প্রথম অ্যাডমিন তৈরি (bootstrap): ডেটাবেজে কোনো অ্যাডমিন না থাকলে
# এই তথ্য দিয়ে একটি অ্যাডমিন অ্যাকাউন্ট তৈরি হয়ে যাবে।
# লগইন: /login → ব্যবহারনাম বা ইমেইল — দুটোতেই চলে।
# তারপর /admin/account থেকে ইমেইল ও পাসওয়ার্ড বদলে নিন।
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_EMAIL="admin@ruposhibangla.org"

# ---- AI (ঐচ্ছিক) ----
# কোনো key না দিলে সাইটের নিজস্ব লোকাল রিট্রিভাল ইঞ্জিন কাজ করবে (ইন্টারনেট লাগবে না)
AI_PROVIDER="local"            # local | openai | openrouter | gemini
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_VISION_MODEL="gpt-4o-mini"

# ---- External species media discovery (all optional; keep secrets server-side) ----
# Pexels API: 200 requests/hour and 20,000/month by default; the admin tool caches metadata.
PEXELS_API_KEY=""
# YouTube Data API: used only from the admin search workflow; embeds are never downloaded.
YOUTUBE_API_KEY=""
# Use a separate long random secret for signing admin review candidates in production.
MEDIA_REVIEW_SECRET=""
# Wikimedia Commons requests identify the app; add a contact address if available.
COMMONS_USER_AGENT="RuposhiBanglaSpeciesMedia/1.0 (https://ruposhibangla.vercel.app)"

# ---- Site ----
NEXT_PUBLIC_SITE_NAME="রূপসী বাংলা"
NEXT_PUBLIC_SITE_URL="https://ruposhibangla.org"
