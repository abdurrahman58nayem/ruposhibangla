# ---- Database (Neon Postgres) ----
# ছাড়া রাখলে সাইটটি লোকাল JSON স্টোরে চলবে (ডেমো/ডেভের জন্য)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/prakriti_bangla?sslmode=require"

# ---- Cloudflare R2 (ছবি/ভিডিও স্টোরেজ) ----
# সেট না করলে আপলোড লোকাল public/uploads ফোল্ডারে জমা হবে
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="prakriti-bangla"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ---- Auth ----
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Admin ----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_EMAIL="admin@prakritibangla.org"

# ---- AI (ঐচ্ছিক) ----
# কোনো key না দিলে সাইটের নিজস্ব লোকাল রিট্রিভাল ইঞ্জিন কাজ করবে (ইন্টারনেট লাগবে না)
AI_PROVIDER="local"            # local | openai | openrouter | gemini
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_VISION_MODEL="gpt-4o-mini"

# ---- Site ----
NEXT_PUBLIC_SITE_NAME="প্রকৃতি বাংলা"
NEXT_PUBLIC_SITE_URL="https://prakritibangla.org"
